# Required by compose.yaml. Never commit real values.
AFRISHIELD_API_KEYS=admin-user=replace-with-at-least-32-random-characters:admin
AFRISHIELD_API_KEY=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AFRISHIELD_DATA_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

AFRISHIELD_AUTH_REQUIRED=true
AFRISHIELD_BACKEND_PORT=8000
AFRISHIELD_FRONTEND_PORT=8501
