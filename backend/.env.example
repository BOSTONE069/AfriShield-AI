APP_NAME=AfriShield Cyber Defence
LLM_PROVIDER=local_transformers
LOCAL_MODEL_PATH=/home/th3c0nf3d3r4t3/.cache/huggingface/hub/models--Qwen--Qwen3-0.6B/snapshots/c1899de289a04d12100db370d81485cdf75e47ca
LOCAL_MAX_NEW_TOKENS=220
USE_LLM=true
LLM_MODEL=Qwen/Qwen3-0.6B
USE_LLM_REPORTS=false
RUNTIME_GPU=auto
RUNTIME_CLOUD=Local Workstation
RUNTIME_BACKEND=Transformers local
RUNTIME_FRAMEWORK=PyTorch CUDA
AFRISHIELD_CORS_ORIGINS=http://localhost:8501
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=50
MAX_EXTRACTED_CHARS=20000
MAX_PARSER_SECONDS=8
MAX_PARSER_MEMORY_MB=256

# Generate separate random keys for each role. Format: secret:role,...
AUTH_REQUIRED=true
AFRISHIELD_API_KEYS=admin-user=replace-with-at-least-32-random-characters:admin
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
FEEDBACK_DATABASE_PATH=data/feedback.db
LEGACY_FEEDBACK_PATH=data/feedback.jsonl
FEEDBACK_RETENTION_DAYS=90
AUDIT_LOG_PATH=data/audit
AUDIT_RETENTION_DAYS=30

ANALYSIS_WORKERS=2
ANALYSIS_QUEUE_SIZE=32
ANALYSIS_JOB_RETENTION_SECONDS=3600
ALLOW_SYNC_ANALYSIS=false

# For AMD Developer Cloud vLLM, use values like these:
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=http://your-amd-vllm-endpoint:8000/v1
# LLM_API_KEY=not-required-or-your-key
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# RUNTIME_GPU=AMD Instinct MI300X
# RUNTIME_CLOUD=AMD Developer Cloud
# RUNTIME_BACKEND=vLLM
# RUNTIME_FRAMEWORK=ROCm + PyTorch
